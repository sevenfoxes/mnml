{
  "name": "mnml-backend",
  "version": "1.0.0",
  "description": "gql",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --no-notify --respawn --transpile-only src/server",
    "start": "node dist/server",
    "clean": "rm  -rf dist",
    "build": "npm -s run clean && npm -s run generate && tsc",
    "generate": "npm -s generate:nexus",
    "generate:nexus": "ts-node --transpile-only src/schema"
  },
  "author": "Scott Nesham",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^4.10.2",
    "graphql": "^16.9.0",
    "graphql-relay": "^0.10.1",
    "graphql-scalars": "^1.23.0",
    "lodash": "^4.17.21",
    "nexus": "^1.3.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.12.2",
    "json-bigint-patch": "^0.0.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3"
  }
}
